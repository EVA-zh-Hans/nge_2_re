TARGET = EBOOT
ATTR = BIN

OBJS = src/loader/loader.o src/loader/ui_draw.o src/loader/image_display.o\
 src/bin/atlas.o

BUILD_YEAR := $(shell date +%Y)
CFLAGS = -O2 -G0 -Wall -DBUILD_YEAR=$(BUILD_YEAR)
CXXFLAGS = $(CFLAGS) -fno-exceptions -fno-rtti
LDFLAGS = -nostartfiles

USE_KERNEL_LIBC = 1
USE_KERNEL_LIBS = 1
LIBS = -lpspge_driver

INCDIR = include

BUILD_PRX = 1
PRX_EXPORTS = src/loader/exports_loader.exp

# Check if DEBUG is set
ifdef DEBUG
CFLAGS += -DPSPDEBUG
endif

PSPSDK=$(shell psp-config --pspsdk-path)
include $(PSPSDK)/lib/build.mak

src/loader/ui_draw.o: include/atlas_data.h

.PHONY: force-loader-year
src/loader/loader.o: force-loader-year
